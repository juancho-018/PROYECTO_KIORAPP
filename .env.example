# URL base de la API de Kiora backend (Azure)
# Se debe utilizar la versión v1 de la API para todas las peticiones
PUBLIC_API_URL=http://localhost:3000/api/v1

# API Key para modo kiosco (machine-to-machine, sin login)
# IMPORTANTE: NO uses un valor real/quemado en entornos públicos de build.
PUBLIC_KIORA_API_KEY=

# Opcional: traducción Weglot (si no se define, no se carga el script)
# PUBLIC_WEGLOT_API_KEY=

